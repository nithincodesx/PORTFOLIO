# GitHub username whose contribution calendar appears in the hero.
GITHUB_USERNAME=nithincodesx

# Public origin used for canonical URLs, sitemap URLs, and Open Graph metadata.
# Set this to the deployed HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-side token (classic PAT with read-only access).
# When set, the server uses GitHub's GraphQL API for the contribution calendar.
# When unset, the server falls back to GitHub's public contributions page,
# which needs no authentication.
#
# IMPORTANT: keep this server-only. Never prefix it with NEXT_PUBLIC_.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin control panel (/control) ──────────────────────────────────────────
# Firebase web-app config (Firebase console → Project settings → Your apps).
# These NEXT_PUBLIC_* values identify your Firebase project — they are public
# by design (every Firebase web app ships them in its bundle) and are NOT
# secrets. Real security is enforced by Firebase Authentication + the Firestore
# security rules in firestore.rules. Never put service-account keys, admin
# passwords, or other server secrets in NEXT_PUBLIC_ variables.
# Copy this file to .env.local and fill in your real values there.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated list of emails allowed to sign in to /control.
# Fail-closed: if unset, nobody gets admin access.
# Keep in sync with the admin email in firestore.rules.
NEXT_PUBLIC_ADMIN_EMAILS=your-admin-email@example.com
